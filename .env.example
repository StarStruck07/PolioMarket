# Copy to .env.local and fill in from your Supabase project (Settings -> API,
# or the "Connect" dialog). Both values are safe to expose to the browser.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Use the "publishable" key (value starts with sb_publishable_...).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# The app also accepts the legacy name if that's what your project shows:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
